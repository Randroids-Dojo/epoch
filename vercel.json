{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "ALLOW-FROM https://randroid.dev" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://randroid.dev https://www.randroid.dev" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
